{
  "name": "fitnova-backend",
  "version": "1.0.0",
  "description": "FitNova gym management API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node src/scripts/test-phase-a-security.js",
    "test:security": "node src/scripts/test-phase-a-security.js",
    "test:config": "node src/scripts/test-phase-b-configuration.js",
    "test:db": "node src/scripts/test-db.js",
    "test:phase-c": "node src/scripts/test-phase-c-workout-reports.js",
    "test:phase-d": "node src/scripts/test-phase-d-database-membership.js",
    "test:phase-e-password": "node src/scripts/test-phase-e-password-change.js",
    "test:phase-e-integration": "node src/scripts/test-phase-e-integration.js",
    "test:phase-e": "node src/scripts/test-phase-e-password-change.js && node src/scripts/test-phase-e-integration.js"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9"
  }
}
