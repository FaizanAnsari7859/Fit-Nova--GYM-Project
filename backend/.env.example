PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200,http://localhost:59162

# MongoDB connection string.
# Local MongoDB: mongodb://127.0.0.1:27017/fitnova
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitnova?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fitnova

# Random string of at least 32 characters. Do not commit the real value.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional one-time bootstrap admin. Leave blank to skip.
# Public registration cannot create an admin account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
