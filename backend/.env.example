# =================================================================
# FitNova Gym Management System — Environment Configuration
# Copy this file to .env and customize values for your environment.
# DO NOT commit real production credentials or secrets to git.
# =================================================================

# Server Port (Required integer > 0)
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed Frontend Origins (CORS)
# Development: Comma-separated dev origins (defaults to http://localhost:4200, http://localhost:59162)
# Production: REQUIRED! Must be explicitly trusted frontend URLs (e.g. https://fitnova.example.com)
# Wildcards (*) are strictly forbidden in production.
CLIENT_URL=http://localhost:4200,http://localhost:59162

# MongoDB Connection String (Required)
# Local: mongodb://127.0.0.1:27017/fitnova
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fitnova?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fitnova

# JSON Web Token Configuration (Required)
# JWT_SECRET: Must be a cryptographically strong string of at least 32 characters.
# Insecure placeholders (e.g. 'secret', 'password') will be rejected on startup.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# Rate Limiting (Optional overrides)
# Window in milliseconds (default: 900000 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Maximum attempts per window (default: 20 in prod, 100 in test)
AUTH_RATE_LIMIT_MAX=20

# Bootstrap Administrator (Optional — initial setup only)
# If provided, an admin account will be automatically created on first boot if not already present.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
